{
  "entities": {
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents a customer profile with their interactions and needs.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Customer entity."
        },
        "name": {
          "type": "string",
          "description": "The full name of the customer."
        },
        "email": {
          "type": "string",
          "description": "The email address of the customer.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the customer."
        },
        "company": {
          "type": "string",
          "description": "The company the customer works for."
        },
        "addedDate": {
          "type": "string",
          "format": "date-time"
        },
        "generalInfo": {
          "type": "string",
          "description": "Information about the customer."
        },
        "needs": {
          "type": "string",
          "description": "The needs of the customer."
        },
        "customerConcerns": {
          "type": "string",
          "description": "The concerns of the customer."
        },
        "displayOrder": {
            "type": "number",
            "description": "Used to order customers in the UI."
        },
        "bestTimeToContact": {
          "type": "string",
          "description": "The best time to contact the customer."
        }
      },
      "required": [
        "id",
        "name",
        "email"
      ]
    },
    "Interaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Interaction",
      "type": "object",
      "description": "Represents an interaction with a customer.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Interaction entity."
        },
        "customerId": {
          "type": "string",
          "description": "Reference to Customer. (Relationship: Customer 1:N Interaction)"
        },
        "date": {
          "type": "string",
          "description": "The date and time of the interaction.",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "description": "The type of interaction (e.g., phone call, email, meeting)."
        },
        "notes": {
          "type": "string",
          "description": "Notes about the interaction."
        }
      },
      "required": [
        "id",
        "customerId",
        "date",
        "type"
      ]
    },
    "Concern": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Concern",
      "type": "object",
      "description": "Represents a customer concern or objection.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Concern entity."
        },
        "customerId": {
          "type": "string",
          "description": "Reference to Customer. (Relationship: Customer 1:N Concern)"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "originalText": {
          "type": "string",
          "description": "The original text of the concern."
        },
        "summary": {
          "type": "string",
          "description": "A summary of the concern generated by AI."
        },
        "category": {
          "type": "string",
          "description": "The category of the concern."
        },
        "status": {
          "type": "string",
          "enum": [
            "new",
            "analyzed",
            "resolved"
          ]
        }
      },
      "required": [
        "id",
        "customerId",
        "date",
        "originalText",
        "summary",
        "category",
        "status"
      ]
    },
    "KnowledgeBaseArticle": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "KnowledgeBaseArticle",
      "type": "object",
      "description": "Represents an article in the knowledge base.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the KnowledgeBaseArticle entity."
        },
        "title": {
          "type": "string",
          "description": "The title of the article."
        },
        "content": {
          "type": "string",
          "description": "The content of the article."
        },
        "category": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "description": "Tags associated with the article.",
          "items": {
            "type": "string"
          }
        },
        "displayOrder": {
            "type": "number",
            "description": "Used to order articles in the UI."
        }
      },
      "required": [
        "id",
        "title",
        "content",
        "category",
        "tags"
      ]
    },
    "Skill": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Skill",
      "type": "object",
      "description": "Represents a sales skill.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Skill entity."
        },
        "title": {
          "type": "string",
          "description": "The title of the skill."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the skill."
        },
        "displayOrder": {
            "type": "number",
            "description": "Used to order skills in the UI."
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "structure": [
      {
        "path": "/customers/{customerId}",
        "definition": {
          "entityName": "Customer",
          "schema": {
            "$ref": "#/entities/Customer"
          },
          "description": "Stores customer profiles."
        }
      },
      {
        "path": "/customers/{customerId}/concerns/{concernId}",
        "definition": {
          "entityName": "Concern",
          "schema": {
            "$ref": "#/entities/Concern"
          },
          "description": "Stores concerns for a specific customer."
        }
      },
      {
        "path": "/knowledge_base_articles/{knowledgeBaseArticleId}",
        "definition": {
          "entityName": "KnowledgeBaseArticle",
          "schema": {
            "$ref": "#/entities/KnowledgeBaseArticle"
          },
          "description": "Stores knowledge base articles."
        }
      },
      {
        "path": "/skills/{skillId}",
        "definition": {
          "entityName": "Skill",
          "schema": {
            "$ref": "#/entities/Skill"
          },
          "description": "Stores sales skills."
        }
      }
    ]
  }
}
