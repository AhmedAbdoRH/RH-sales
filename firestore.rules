/**
 * @fileoverview Firestore Security Rules for SalesPro Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for customer data (interactions, concerns)
 * and allows public read access to knowledge base articles.
 *
 * Data Structure:
 * - /customers/{customerId}: Stores customer profiles.
 * - /customers/{customerId}/interactions/{interactionId}: Stores interactions related to a customer.
 * - /customers/{customerId}/concerns/{concernId}: Stores concerns related to a customer.
 * - /knowledge_base_articles/{knowledgeBaseArticleId}: Stores knowledge base articles (publicly readable).
 *
 * Key Security Decisions:
 * - Customer data (interactions, concerns) is strictly controlled by user ownership enforced via path-based rules.
 * - Knowledge base articles are publicly readable but writes are not currently permitted.
 *
 *  Denormalization for Authorization:
 *  - The 'Interaction' and 'Concern' entities include a 'customerId' field which gets validated
 *    against the path to prevent moving documents between customers.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to customer profiles. Allows read/write access only to the owner.
     * @path /customers/{customerId}
     * @allow (create) - User abc can create a customer profile where customerId == user abc's id
     * @allow (get) - User abc can read customer profile where customerId == user abc's id
     * @allow (update) - User abc can update customer profile where customerId == user abc's id
     * @allow (delete) - User abc can delete customer profile where customerId == user abc's id
     * @deny (create) - User xyz cannot create a customer profile where customerId == user abc's id
     * @deny (get) - User xyz cannot read customer profile where customerId == user abc's id
     * @deny (update) - User xyz cannot update customer profile where customerId == user abc's id
     * @deny (delete) - User xyz cannot delete customer profile where customerId == user abc's id
     * @principle Enforces document ownership for all operations.
     */
    match /customers/{customerId} {
      allow get: if isSignedIn() && isOwner(customerId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(customerId) && request.resource.data.id == customerId;
      allow update: if isSignedIn() && isExistingOwner(customerId) && resource.data.id == customerId;
      allow delete: if isSignedIn() && isExistingOwner(customerId);
    }

    /**
     * @description Controls access to customer interactions.  Allows read/write access only to the owner.
     * @path /customers/{customerId}/interactions/{interactionId}
     * @allow (create) - User abc can create an interaction for customer abc
     * @allow (get) - User abc can read interaction for customer abc
     * @allow (update) - User abc can update interaction for customer abc
     * @allow (delete) - User abc can delete interaction for customer abc
     * @deny (create) - User xyz cannot create an interaction for customer abc
     * @deny (get) - User xyz cannot read interaction for customer abc
     * @deny (update) - User xyz cannot update interaction for customer abc
     * @deny (delete) - User xyz cannot delete interaction for customer abc
     * @principle Enforces document ownership and referential integrity.
     */
    match /customers/{customerId}/interactions/{interactionId} {
      allow get: if isSignedIn() && isOwner(customerId);
      allow list: if isSignedIn() && isOwner(customerId);
      allow create: if isSignedIn() && isOwner(customerId) && request.resource.data.customerId == customerId;
      allow update: if isSignedIn() && isExistingOwner(customerId) && resource.data.customerId == customerId;
      allow delete: if isSignedIn() && isExistingOwner(customerId);
    }

    /**
     * @description Controls access to customer concerns. Allows read/write access only to the owner.
     * @path /customers/{customerId}/concerns/{concernId}
     * @allow (create) - User abc can create a concern for customer abc
     * @allow (get) - User abc can read concern for customer abc
     * @allow (update) - User abc can update concern for customer abc
     * @allow (delete) - User abc can delete concern for customer abc
     * @deny (create) - User xyz cannot create a concern for customer abc
     * @deny (get) - User xyz cannot read concern for customer abc
     * @deny (update) - User xyz cannot update concern for customer abc
     * @deny (delete) - User xyz cannot delete concern for customer abc
     * @principle Enforces document ownership and referential integrity.
     */
    match /customers/{customerId}/concerns/{concernId} {
      allow get: if isSignedIn() && isOwner(customerId);
      allow list: if isSignedIn() && isOwner(customerId);
      allow create: if isSignedIn() && isOwner(customerId) && request.resource.data.customerId == customerId;
      allow update: if isSignedIn() && isExistingOwner(customerId) && resource.data.customerId == customerId;
      allow delete: if isSignedIn() && isExistingOwner(customerId);
    }

    /**
     * @description Controls access to knowledge base articles. Allows public read access, but no write access.
     * @path /knowledge_base_articles/{knowledgeBaseArticleId}
     * @allow (get) - Any user (signed in or not) can read a knowledge base article.
     * @allow (list) - Any user (signed in or not) can list knowledge base articles.
     * @deny (create) - No one can create a knowledge base article (writes are disabled for this prototype).
     * @deny (update) - No one can update a knowledge base article (writes are disabled for this prototype).
     * @deny (delete) - No one can delete a knowledge base article (writes are disabled for this prototype).
     * @principle Allows public read access but restricts write access.
     */
    match /knowledge_base_articles/{knowledgeBaseArticleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}