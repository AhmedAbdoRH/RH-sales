/**
 * @fileoverview Firestore Security Rules for SalesPro Hub.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for customer data (Interactions, Concerns),
 * with public read access to knowledge base articles.
 *
 * Data Structure:
 * - /customers/{customerId}: Stores customer profiles.
 * - /customers/{customerId}/interactions/{interactionId}: Stores interactions related to a specific customer.
 * - /customers/{customerId}/concerns/{concernId}: Stores concerns related to a specific customer.
 * - /knowledge_base_articles/{knowledgeBaseArticleId}: Stores knowledge base articles accessible to all users.
 *
 * Key Security Decisions:
 * - Customers collection requires authentication to list.
 * - User-specific data (interactions, concerns) is secured via path-based ownership.
 * - Knowledge base articles are publicly readable.
 * - Write operations are always protected by authentication and authorization checks.
 *
 * Denormalization for Authorization:
 * - Customer subcollections (`interactions`, `concerns`) use path-based authorization, relying on the `customerId` in the path.
 *
 * Structural Segregation:
 * - Private customer data is stored in subcollections under `/customers/{customerId}`, while public knowledge base articles reside in a top-level collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secures the customers collection. Only authenticated users can list customers.
     * @path /customers/{customerId}
     * @allow get: if false;
     * @allow list: if isSignedIn();
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @deny get: if true;
     * @principle Requires authentication to list customers and explicitly denies all write operations.
     */
    match /customers/{customerId} {
      allow get: if false;
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Secures interactions subcollection. Only the owner of the customer data can manage interactions.
     * @path /customers/{customerId}/interactions/{interactionId}
     * @allow get: if isOwner(customerId);
     * @allow list: if isOwner(customerId);
     * @allow create: if isSignedIn() && request.resource.data.customerId == customerId;
     * @allow update: if isExistingOwner(customerId) && resource.data.customerId == customerId;
     * @allow delete: if isExistingOwner(customerId);
     * @deny get: if !isSignedIn();
     * @deny list: if !isSignedIn();
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /customers/{customerId}/interactions/{interactionId} {
      allow get: if isOwner(customerId);
      allow list: if isOwner(customerId);
      allow create: if isSignedIn() && request.resource.data.customerId == customerId;
      allow update: if isExistingOwner(customerId) && resource.data.customerId == customerId;
      allow delete: if isExistingOwner(customerId);
    }

    /**
     * @description Secures concerns subcollection. Only the owner of the customer data can manage concerns.
     * @path /customers/{customerId}/concerns/{concernId}
     * @allow get: if isOwner(customerId);
     * @allow list: if isOwner(customerId);
     * @allow create: if isSignedIn() && request.resource.data.customerId == customerId;
     * @allow update: if isExistingOwner(customerId) && resource.data.customerId == customerId;
     * @allow delete: if isExistingOwner(customerId);
     * @deny get: if !isSignedIn();
     * @deny list: if !isSignedIn();
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /customers/{customerId}/concerns/{concernId} {
      allow get: if isOwner(customerId);
      allow list: if isOwner(customerId);
      allow create: if isSignedIn() && request.resource.data.customerId == customerId;
      allow update: if isExistingOwner(customerId) && resource.data.customerId == customerId;
      allow delete: if isExistingOwner(customerId);
    }

    /**
     * @description Secures knowledge base articles collection. Allows public read access, but requires authentication for writes.
     * @path /knowledge_base_articles/{knowledgeBaseArticleId}
     * @allow get: if true;
     * @allow list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @principle Allows public read access while restricting write access to authenticated users.
     */
    match /knowledge_base_articles/{knowledgeBaseArticleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(customerId) {
      return request.auth.uid == customerId;
    }

    function isExistingOwner(customerId) {
      return isOwner(customerId) && resource != null;
    }
  }
}