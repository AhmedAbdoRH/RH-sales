/**
 * @file Firebase Security Rules for Firestore.
 * @description This ruleset enforces a security model where customers can be listed but only authenticated users can access or modify customer details, concerns, knowledge base articles, and skills.
 *
 * Data Structure:
 * - /customers/{customerId}: Stores customer profiles. Only authenticated users can create, update, or delete.
 * - /customers/{customerId}/concerns/{concernId}: Stores customer concerns.  Only authenticated users can create, update, or delete.
 * - /knowledge_base_articles/{knowledgeBaseArticleId}: Stores knowledge base articles.  Only authenticated users can create, update, or delete.
 * - /skills/{skillId}: Stores sales skills. Only authenticated users can create, update, or delete.
 *
 * Key Security Decisions:
 * - Listing customers is allowed for all users (including unauthenticated).
 * - Detailed access and modification of customer data, concerns, knowledge base articles, and skills requires authentication.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows listing customers for all users, but requires authentication to create, update, or delete customer data.
     * @path /customers/{customerId}
     * @allow (list) - Any user can list customers.
     * @allow (create) - Authenticated user can create a customer.
     * @deny (create) - Unauthenticated user cannot create a customer.
     * @allow (get) - Authenticated user can get a specific customer.
     * @deny (get) - Unauthenticated user cannot get a specific customer.
     * @allow (update) - Authenticated user can update a specific customer.
     * @deny (update) - Unauthenticated user cannot update a specific customer.
     * @allow (delete) - Authenticated user can delete a specific customer.
     * @deny (delete) - Unauthenticated user cannot delete a customer.
     * @principle Public read, authenticated writes.
     */
    match /customers/{customerId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to manage concerns for specific customers.
     * @path /customers/{customerId}/concerns/{concernId}
     * @allow (create) - Authenticated user can create a concern for a customer.
     * @deny (create) - Unauthenticated user cannot create a concern for a customer.
     * @allow (get) - Authenticated user can get a specific concern.
     * @deny (get) - Unauthenticated user cannot get a specific concern.
     * @allow (update) - Authenticated user can update a specific concern.
     * @deny (update) - Unauthenticated user cannot update a specific concern.
     * @allow (delete) - Authenticated user can delete a concern.
     * @deny (delete) - Unauthenticated user cannot delete a concern.
     * @allow (list) - Authenticated user can list concerns for a customer.
     * @deny (list) - Unauthenticated user cannot list concerns for a customer.
     * @principle Requires authentication for all operations.
     */
    match /customers/{customerId}/concerns/{concernId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to manage knowledge base articles.
     * @path /knowledge_base_articles/{knowledgeBaseArticleId}
     * @allow (create) - Authenticated user can create a knowledge base article.
     * @deny (create) - Unauthenticated user cannot create a knowledge base article.
     * @allow (get) - Authenticated user can get a specific knowledge base article.
     * @deny (get) - Unauthenticated user cannot get a specific knowledge base article.
     * @allow (update) - Authenticated user can update a specific knowledge base article.
     * @deny (update) - Unauthenticated user cannot update a specific knowledge base article.
     * @allow (delete) - Authenticated user can delete a knowledge base article.
     * @deny (delete) - Unauthenticated user cannot delete a knowledge base article.
     * @allow (list) - Authenticated user can list knowledge base articles.
     * @deny (list) - Unauthenticated user cannot list knowledge base articles.
     * @principle Requires authentication for all operations.
     */
    match /knowledge_base_articles/{knowledgeBaseArticleId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to manage sales skills.
     * @path /skills/{skillId}
     * @allow (create) - Authenticated user can create a sales skill.
     * @deny (create) - Unauthenticated user cannot create a sales skill.
     * @allow (get) - Authenticated user can get a specific sales skill.
     * @deny (get) - Unauthenticated user cannot get a specific sales skill.
     * @allow (update) - Authenticated user can update a specific sales skill.
     * @deny (update) - Unauthenticated user cannot update a specific sales skill.
     * @allow (delete) - Authenticated user can delete a sales skill.
     * @deny (delete) - Unauthenticated user cannot delete a sales skill.
     * @allow (list) - Authenticated user can list sales skills.
     * @deny (list) - Unauthenticated user cannot list sales skills.
     * @principle Requires authentication for all operations.
     */
    match /skills/{skillId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }
}